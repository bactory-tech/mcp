{
  "name": "bactory-mcp",
  "version": "0.1.0",
  "description": "MCP server for Bactory: live Base market data and AgentGuard checks for AI assistants. Agents propose, contracts enforce.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bactory-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "base",
    "defi",
    "agents",
    "ai-agents",
    "claude",
    "uniswap",
    "chainlink",
    "bactory"
  ],
  "homepage": "https://bactory.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bactory-tech/bactory-mcp.git"
  },
  "bugs": "https://github.com/bactory-tech/bactory-mcp/issues",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
